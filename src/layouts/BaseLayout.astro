---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
  </head>
  <body>
    <p>
      <a href="/">Home</a> | <a href="/about/">About</a> |
      <a href="/rss.xml">RSS</a>
    </p>
    <slot />
    <hr />
    <p>
      <small>
        If you have any comments about this WEB page, you can find me on
        <a href="https://github.com/checkpoint214159">GitHub</a>. However, due
        to the limited number of personnel in our corporate office, I am unable
        to provide a direct response.
      </small>
    </p>
    <p><small>Copyright © 2025-{year} ben</small></p>
  </body>
</html>
